include LICENSE README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md SPEC.md CREDITS.md AGENTS.md
recursive-include params *
recursive-include validation *.csv *.json *.xml *.txt
recursive-include tests *.py
recursive-include scripts *.py
recursive-include docs *.md
recursive-include paper *.py *.tex *.bib *.tikz Makefile
exclude coverage.json
global-exclude __pycache__ *.py[cod]
